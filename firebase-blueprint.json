{
  "entities": {
    "cbt_state": {
      "title": "CBT State",
      "description": "Synchronized CBT data including proctor credentials, exams, participants, questions, and attempts across all proctor and student devices",
      "properties": {
        "adminConfig": {
          "type": "object",
          "description": "Proctor login credentials and school info"
        },
        "topics": {
          "type": "array",
          "description": "Subject topics"
        },
        "questions": {
          "type": "array",
          "description": "Question bank"
        },
        "groups": {
          "type": "array",
          "description": "Student classes/groups"
        },
        "participants": {
          "type": "array",
          "description": "Registered students"
        },
        "tests": {
          "type": "array",
          "description": "Active and scheduled tests"
        },
        "testAttempts": {
          "type": "array",
          "description": "Student test attempts and results"
        },
        "teachers": {
          "type": "array",
          "description": "Teacher accounts"
        },
        "currentToken": {
          "type": "string",
          "description": "Current active exam token"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last synchronization timestamp"
        }
      },
      "required": ["updatedAt"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
